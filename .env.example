# Vertikl (server-only — never prefix with NEXT_PUBLIC_)
VERTIKL_API_KEY=
# "test" → /api/leads/test | "production" → /api/leads (default if unset: test)
VERTIKL_API_MODE=test

# One Vertikl campaignId per first-touch source (fill locally / in Vercel — do not commit secrets)
VERTIKL_CAMPAIGN_ID_INSTAGRAM_ORGANIC=
VERTIKL_CAMPAIGN_ID_META_INSTAGRAM_PAID=
VERTIKL_CAMPAIGN_ID_FACEBOOK_ORGANIC=
VERTIKL_CAMPAIGN_ID_META_FACEBOOK_PAID=
VERTIKL_CAMPAIGN_ID_GOOGLE_PAID=
VERTIKL_CAMPAIGN_ID_TIKTOK_ORGANIC=
VERTIKL_CAMPAIGN_ID_TIKTOK_PAID=
VERTIKL_CAMPAIGN_ID_REFERRAL=
VERTIKL_CAMPAIGN_ID_DIRECT=
VERTIKL_CAMPAIGN_ID_META_PAID_UNATTRIBUTED=

# Meta Pixel + Conversions API (implemented in app code — NOT via GTM)
# Pixel / dataset id — public, used by the browser pixel and the server CAPI
NEXT_PUBLIC_META_PIXEL_ID=1065365083166325
# Conversions API access token (server-only — never prefix with NEXT_PUBLIC_, never commit)
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager "Test events" code (leave empty in production)
META_TEST_EVENT_CODE=
